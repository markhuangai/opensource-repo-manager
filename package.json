{
  "name": "opensource-repo-manager",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted GitHub repository maintenance service.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node dist/main.js",
    "config:validate": "node src/main.ts config validate",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:container": "node scripts/test-container.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
